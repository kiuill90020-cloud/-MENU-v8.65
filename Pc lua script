local function SelectTab(tabName)
    for name, page in pairs(TabPages) do page.Visible = (name == tabName) end
    for name, btn in pairs(TabButtons) do
        if name == tabName then Tween(btn, {BackgroundColor3 = Theme.Surface, TextColor3 = Theme.Accent}, 0.2)
        else Tween(btn, {BackgroundColor3 = Theme.Background, TextColor3 = Theme.TextSecondary}, 0.2) end
    end
    
    if tabName == "Управление миром" and not expWarningShown then
        ExpWarningFrame.Visible = true
    end
end


local function RegisterTab(tabName, iconText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 42)
    btn.BackgroundColor3 = Theme.Background
    btn.Text = iconText .. "  " .. tabName
