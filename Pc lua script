local function CleanShaders()
    for _, effect in pairs(Lighting:GetChildren()) do
        if string.match(effect.Name, "^LITE_") then effect:Destroy() end
    end
end
CleanShaders()


local fxCC = Instance.new("ColorCorrectionEffect") fxCC.Name = "LITE_CC"
local fxBloom = Instance.new("BloomEffect") fxBloom.Name = "LITE_Bloom"
local fxSun = Instance.new("SunRaysEffect") fxSun.Name = "LITE_Sun"
local fxAtmos = Instance.new("Atmosphere") fxAtmos.Name = "LITE_Atmosphere"
local fxDOF = Instance.new("DepthOfFieldEffect") fxDOF.Name = "LITE_DOF"


local function ApplyShaderInstances()
    if not Lighting:FindFirstChild("LITE_CC") then fxCC.Parent = Lighting end
    if not Lighting:FindFirstChild("LITE_Bloom") then fxBloom.Parent = Lighting end
    if not Lighting:FindFirstChild("LITE_Sun") then fxSun.Parent = Lighting end
    if not Lighting:FindFirstChild("LITE_Atmosphere") then fxAtmos.Parent = Lighting end
    if not Lighting:FindFirstChild("LITE_DOF") then fxDOF.Parent = Lighting end
end


_G.ForceUpdateShaders = function(presetType)
    if not presetType then presetType = Config.graphicsPreset end
    ApplyShaderInstances()
    
    if presetType == "RTX" then
        fxCC.Enabled = true fxBloom.Enabled = true fxSun.Enabled = true fxDOF.Enabled = false
        fxCC.Brightness = 0.05 fxCC.Contrast = 0.15 fxCC.Saturation = 0.25 fxCC.TintColor = Color3.fromRGB(240, 235, 225)
        fxBloom.Intensity = 0.4 fxBloom.Size = 25
        fxSun.Intensity = 0.3 fxSun.Spread = 0.6
        fxAtmos.Density = 0.1 fxAtmos.Haze = 1.0 fxAtmos.Color = Color3.fromRGB(200, 190, 180)
        Config.graphicsPreset = "RTX" 
    elseif presetType == "RAW" then
        fxCC.Enabled = true fxBloom.Enabled = true fxSun.Enabled = true fxDOF.Enabled = true
        fxCC.Brightness = -0.1 fxCC.Contrast = 0.3 fxCC.Saturation = 0.4 fxCC.TintColor = Color3.fromRGB(255, 250, 245)
        fxBloom.Intensity = 0.2 fxBloom.Size = 10
        fxSun.Intensity = 0.5 fxSun.Spread = 0.7
        fxAtmos.Density = 0.2 fxAtmos.Haze = 2.0 fxAtmos.Color = Color3.fromRGB(180, 190, 200)
        fxDOF.FocusDistance = 25 fxDOF.InFocusRadius = 50 fxDOF.NearIntensity = 0.2 fxDOF.FarIntensity = 0.5
        Config.graphicsPreset = "RAW" 
    elseif presetType == "Custom" then
        fxCC.Enabled = true fxBloom.Enabled = true fxSun.Enabled = true fxDOF.Enabled = false
        local s = Config.gfx
        fxCC.Brightness = s.bright fxCC.Contrast = s.cont fxCC.Saturation = s.sat fxCC.TintColor = Color3.new(1,1,1)
        fxBloom.Intensity = s.bloomInt fxBloom.Size = s.bloomSz fxSun.Intensity = s.sunInt
        fxAtmos.Density = s.atmos fxAtmos.Haze = 1.5 fxAtmos.Color = Color3.fromRGB(199,199,199)
        Config.graphicsPreset = "Custom"
    else
        fxCC.Enabled = false fxBloom.Enabled = false fxSun.Enabled = false fxAtmos.Density = 0 fxDOF.Enabled = false
        Config.graphicsPreset = "None"
    end
end


