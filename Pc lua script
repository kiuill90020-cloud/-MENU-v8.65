local function SetupButtonHover(button)
    local defColor = button.BackgroundColor3
    button.MouseEnter:Connect(function() if not button:GetAttribute("IsOn") then Tween(button, {BackgroundColor3 = Theme.SurfaceLight}, 0.15) end end)
    button.MouseLeave:Connect(function() if not button:GetAttribute("IsOn") then Tween(button, {BackgroundColor3 = defColor}, 0.15) end end)
end


local function CreateToggle(parent, text, stateVar, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = stateVar and Theme.Accent or Theme.Surface
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn:SetAttribute("IsOn", stateVar)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -40, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = stateVar and Theme.Background or Theme.TextPrimary
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn
    
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 10, 0, 10)
    indicator.Position = UDim2.new(1, -25, 0.5, -5)
    indicator.BackgroundColor3 = stateVar and Theme.Background or Theme.TextSecondary
    indicator.BorderSizePixel = 0
    indicator.Parent = btn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)


    SetupButtonHover(btn)


    local function ForceUIUpdate(newState)
        btn:SetAttribute("IsOn", newState)
        if newState then 
            Tween(btn, {BackgroundColor3 = Theme.Accent}, 0.2) 
            Tween(label, {TextColor3 = Theme.Background}, 0.2) 
            Tween(indicator, {BackgroundColor3 = Theme.Background}, 0.2)
        else 
            Tween(btn, {BackgroundColor3 = Theme.Surface}, 0.2) 
            Tween(label, {TextColor3 = Theme.TextPrimary}, 0.2) 
            Tween(indicator, {BackgroundColor3 = Theme.TextSecondary}, 0.2) 
        end
    end


    btn.MouseButton1Click:Connect(function()
        local newState = not btn:GetAttribute("IsOn")
        ForceUIUpdate(newState)
        callback(newState)
    end)
    
    return btn, ForceUIUpdate
end


