    label.TextColor3 = Theme.TextPrimary
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row
    
    local displayBind = Config.Binds[configKey] == "None" and "- -" or Config.Binds[configKey]
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 1, 0)
    btn.Position = UDim2.new(1, -200, 0, 0)
    btn.BackgroundColor3 = Theme.Surface
    btn.Text = "[" .. displayBind .. "]"
    btn.TextColor3 = Theme.TextPrimary
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = row
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        btn.Text = "ЖДУ НАЖАТИЯ..."
        btn.BackgroundColor3 = Theme.Accent
        btn.TextColor3 = Theme.Background
        isBindingKey = true
        
        local captureConn
        captureConn = UserInputService.InputBegan:Connect(function(inputObj)
            local newKey = GetInputName(inputObj)
            if newKey then
                Config.Binds[configKey] = newKey
                btn.Text = (newKey == "None" and "[- -]" or "[" .. newKey .. "]")
                btn.BackgroundColor3 = Theme.Surface
                btn.TextColor3 = Theme.TextPrimary
                SaveConfig()
                task.delay(0.2, function() isBindingKey = false end)
                captureConn:Disconnect()
            end
        end)
    end)
end


