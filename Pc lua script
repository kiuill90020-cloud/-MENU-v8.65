UserInputService.InputBegan:Connect(function(inputInfo, isProcessed)
    if isBindingKey then return end
    if UserInputService:GetFocusedTextBox() then return end
    
    local keyName = GetInputName(inputInfo)
    if not keyName or keyName == "None" then return end 
    
    if keyName == Config.Binds.Menu then
        MainFrame.Visible = not MainFrame.Visible 
        
    elseif keyName == Config.Binds.Adaptive then
        local newState = not Config.adaptivePerformance
        Config.adaptivePerformance = newState
        SaveConfig()
        updateAdaptiveUI(newState)


    elseif keyName == Config.Binds.ESP then
        local newState = not Config.esp.enabled
        Config.esp.enabled = newState
        SaveConfig()
        updateEspUI(newState)
        
        if not newState then
            for _, data in pairs(playerHighlights) do
                if data.Highlight then data.Highlight:Destroy() end
                if data.Billboard then data.Billboard:Destroy() end
            end
            playerHighlights = {}
        end
        
    elseif keyName == Config.Binds.Ghost then
        local newState = not Config.ghostEnabled
        Config.ghostEnabled = newState
        SaveConfig()
        updateGhostUI(newState)
        
        local char = localPlayer.Character
        if newState then
            if char then 
                 for _, part in pairs(char:GetDescendants()) do 
                    if part:IsA("BasePart") then part.CanCollide = false end 
                end 
            end
            if ghostConnection then ghostConnection:Disconnect() end
             if char then 
                ghostConnection = char.DescendantAdded:Connect(function(child) 
                    if Config.ghostEnabled and child:IsA("BasePart") then child.CanCollide = false end 
                end) 
            end
        else
             if char then 
                 for _, part in pairs(char:GetDescendants()) do 
                    if part:IsA("BasePart") then part.CanCollide = true end 
                end 
            end
            if ghostConnection then 
                ghostConnection:Disconnect()
                ghostConnection = nil 
            end
        end
        
    elseif keyName == Config.Binds.Fly then
        local newState = not Config.flyEnabled
        Config.flyEnabled = newState
        SaveConfig()
        updateFlyUI(newState)
        
        local char = localPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        if newState and rootPart and humanoid then
            humanoid.PlatformStand = true
             if flyBodyVel then flyBodyVel:Destroy() end
            if flyBodyGyro then flyBodyGyro:Destroy() end
            
            flyBodyGyro = Instance.new("BodyGyro") 
            flyBodyGyro.P = 90000 
            flyBodyGyro.maxTorque = Vector3.new(math.huge, math.huge, math.huge) 
            flyBodyGyro.cframe = rootPart.CFrame 
             flyBodyGyro.Parent = rootPart
            
            flyBodyVel = Instance.new("BodyVelocity") 
            flyBodyVel.velocity = Vector3.new(0, 0, 0) 
            flyBodyVel.maxForce = Vector3.new(math.huge, math.huge, math.huge) 
            flyBodyVel.Parent = rootPart
            
            RunService:BindToRenderStep("LiteFlyRoutine", Enum.RenderPriority.Camera.Value, function()
                local curRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not curRoot or not flyBodyVel then return end
                
                flyBodyGyro.cframe = workspace.CurrentCamera.CFrame
                local dir = Vector3.new()
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + workspace.CurrentCamera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - workspace.CurrentCamera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - workspace.CurrentCamera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + workspace.CurrentCamera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
                
                if dir.Magnitude > 0 then 
                    flyBodyVel.velocity = dir.Unit * Config.flySpeed 
                else 
                    flyBodyVel.velocity = Vector3.new(0, 0, 0) 
                end
            end)
        else
            RunService:UnbindFromRenderStep("LiteFlyRoutine")
            if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
            if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
            if humanoid then humanoid.PlatformStand = false end
        end
        
    elseif keyName == Config.Binds.SpeedUp then
        Config.walkSpeed = Config.walkSpeed + 10
        if inputRowsSync["walkSpeed"] then inputRowsSync["walkSpeed"](Config.walkSpeed) end
        GlobalPhysicsUpdate()
        
    elseif keyName == Config.Binds.SpeedDown then
        Config.walkSpeed = math.max(1, Config.walkSpeed - 10)
        if inputRowsSync["walkSpeed"] then inputRowsSync["walkSpeed"](Config.walkSpeed) end
        GlobalPhysicsUpdate()
        
    elseif keyName == Config.Binds.ClickTP then
        local newState = not Config.clickTpEnabled
        Config.clickTpEnabled = newState
        SaveConfig()
        updateClickTPUI(newState)
        OnExpToggled()
        
    elseif keyName == Config.Binds.NightVision then
        local newState = not Config.nightVision
        Config.nightVision = newState
        SaveConfig()
        updateNVUI(newState)
        OnExpToggled()
        
        if newState then
             nvEffect.Parent = Lighting
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        else
            if nvEffect.Parent then nvEffect.Parent = nil end
            Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        end
        
    elseif keyName == Config.Binds.AuraFling then
         local newState = not Config.exp.auraFling
        Config.exp.auraFling = newState
        SaveConfig()
        updateAuraUI(newState)
        OnExpToggled()
        
    elseif keyName == Config.Binds.RainbowESP then
        local newState = not Config.exp.rainbowEsp
        Config.exp.rainbowEsp = newState
        SaveConfig()
        updateRainbowUI(newState)
        OnExpToggled()
    end
end)


