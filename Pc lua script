-- ==============================================================================
RunService.Heartbeat:Connect(function(deltaTime)
    pcall(function()
        local fps = math.floor(1 / deltaTime)
        local mem = math.floor(Stats:GetTotalMemoryUsageMb())
        HeaderStats.Text = string.format("FPS: %d | MEM: %d MB", fps, mem)
    end)


    if timeGlitchActive then
        local targetTime = Config.timeOfDay
        if math.random(1, 100) > 95 then -- Мягкий шанс сбоя (5%)
            Lighting.ClockTime = targetTime + (math.random(-5, 5) / 10) -- Легкое дрожание
        else
            Lighting.ClockTime = targetTime
        end
    end


    local char = localPlayer.Character
    if not char then return end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not rootPart or not humanoid then return end
    
    if Config.walkSpeed > 16 and humanoid.MoveDirection.Magnitude > 0 and not Config.flyEnabled then
        local multiplier = (Config.walkSpeed / 16) - 1
        if multiplier > 0 then
            rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (multiplier * deltaTime * 16))
        end
    end
    
    if Config.exp.auraFling then
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= localPlayer and otherPlayer.Character and not IsProtected(otherPlayer) then
                local enemyRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                if enemyRoot and (enemyRoot.Position - rootPart.Position).Magnitude < 15 then
                    local originalCFrame = rootPart.CFrame
                    rootPart.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
                    local spinner = Instance.new("BodyAngularVelocity")
                    spinner.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    spinner.AngularVelocity = Vector3.new(0, 99999, 0)
                    spinner.Parent = rootPart
                    
                    rootPart.CFrame = CFrame.new(enemyRoot.Position)
                    rootPart.Velocity = Vector3.new(0, 50000, 0)
                    task.wait(0.05)
                    
                    if spinner then spinner:Destroy() end
                    rootPart.CFrame = originalCFrame
                    rootPart.Velocity = Vector3.new(0, 0, 0)
                    rootPart.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                end
            end
        end
    end
end)


