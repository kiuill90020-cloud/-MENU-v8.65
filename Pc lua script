local function GetInputName(inputObj)
    if inputObj.KeyCode == Enum.KeyCode.Backspace or inputObj.KeyCode == Enum.KeyCode.Escape then return "None"
    elseif inputObj.UserInputType == Enum.UserInputType.Keyboard then return inputObj.KeyCode.Name
    elseif inputObj.UserInputType == Enum.UserInputType.MouseButton4 then return "Mouse4"
    elseif inputObj.UserInputType == Enum.UserInputType.MouseButton5 then return "Mouse5"
    elseif inputObj.UserInputType == Enum.UserInputType.MouseButton3 then return "Mouse3" end
    return nil
end


local function CreateBindRow(text, configKey)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundTransparency = 1
    row.Parent = PageBinds
    
    local label = Instance.new("TextLabel")
